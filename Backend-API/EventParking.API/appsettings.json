{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=(Localdb\\MSSQLLocalDB);Database=EventParkingDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "EventReservationApi",
    "Audience": "EventReservationClients",
    "ExpiryMinutes": 120
  },

  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 587,
    "SenderName": "Event & Parking Reservation System",
    "SenderEmail": "noreply@yourdomain.com",
    "Username": "your_smtp_username",
     
    "Password": "your_smtp_password",
    "EnableSsl": true
  },

  "BusinessRules": {
    "BookingHoldMinutes": 15,
    "EmailVerificationTokenExpiryHours": 24,
    "PasswordResetTokenExpiryMinutes": 60
  }
}